<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.DataBalancingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:D2G.Iris.ML.ConfigUI.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToDecimalConverter x:Key="StringToDecimalConverter"/>
    </UserControl.Resources>

    <GroupBox Header="Data Balancing Settings" Margin="10">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
            <Label Grid.Row="0" Grid.Column="0" Content="Method:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" 
                      ItemsSource="{Binding AvailableMethods}"
                      SelectedItem="{Binding SelectedMethod}"
                      VerticalAlignment="Center" Height="25" Width="200" HorizontalAlignment="Left"/>

            
            <Label Grid.Row="2" Grid.Column="0" Content="Execution Order:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsSmoteSelected}"/>
            <TextBox Grid.Row="2" Grid.Column="1" 
                     Text="{Binding ExecutionOrder, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" Height="25" Width="80" HorizontalAlignment="Left"
                     IsEnabled="{Binding IsSmoteSelected}"/>


            <Label Grid.Row="4" Grid.Column="0" Content="K Neighbors:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsSmoteSelected}"
                   ToolTip="Number of nearest neighbors for SMOTE (1-20)"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding KNeighbors, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                         VerticalAlignment="Center" Height="25" Width="80"
                         IsEnabled="{Binding IsSmoteSelected}"
                         ToolTip="Enter number of neighbors (e.g., 5)"/>
                <TextBlock Text=" (e.g., 5)" VerticalAlignment="Center" Margin="5,0,0,0"
                           Foreground="Gray" FontSize="10"/>
            </StackPanel>


            <Label Grid.Row="6" Grid.Column="0" Content="Undersampling Ratio:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsSmoteSelected}"
                   ToolTip="Fraction of majority class to keep"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding UndersamplingRatioText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Height="25" Width="80"
                         IsEnabled="{Binding IsSmoteSelected}"
                         PreviewTextInput="DecimalTextBox_PreviewTextInput"
                         DataObject.Pasting="DecimalTextBox_Pasting"
                         ToolTip="Enter decimal value (e.g., 0.5 or 1.0)"/>
                <TextBlock Text=" (e.g., 0.5)" VerticalAlignment="Center" Margin="5,0,0,0"
                           Foreground="Gray" FontSize="10"/>
            </StackPanel>


            <Label Grid.Row="8" Grid.Column="0" Content="Minority to Majority Ratio:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsSmoteSelected}"
                   ToolTip="Target ratio of minority to majority after balancing"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding MinorityToMajorityRatioText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Height="25" Width="80"
                         IsEnabled="{Binding IsSmoteSelected}"
                         PreviewTextInput="DecimalTextBox_PreviewTextInput"
                         DataObject.Pasting="DecimalTextBox_Pasting"
                         ToolTip="Enter decimal value (e.g., 0.8 or 1.0)"/>
                <TextBlock Text=" (e.g., 0.8)" VerticalAlignment="Center" Margin="5,0,0,0"
                           Foreground="Gray" FontSize="10"/>
            </StackPanel>

            
            <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" 
                       Text="{Binding Description}" 
                       TextWrapping="Wrap" 
                       Foreground="DarkBlue"
                       Margin="0,10,0,0"/>
        </Grid>
    </GroupBox>
</UserControl>