<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.ResidualPlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#F8F9FA" Padding="20" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Residual Analysis"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#2C3E50"/>
                <TextBlock Text="Diagnostic plots for regression model performance"
                           FontSize="12"
                           Foreground="#7F8C8D"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- No Data Placeholder -->
            <Border Background="#F8F9FA"
                    CornerRadius="8"
                    Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📊" FontSize="64" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="No Residual Plot Data Available"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#7F8C8D"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                    <TextBlock Text="Residual plots are available for regression models only"
                               FontSize="12"
                               Foreground="#95A5A6"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Plots TabControl -->
            <TabControl Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="10"
                        Background="Transparent"
                        BorderThickness="0">

                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border"
                                            Background="White"
                                            BorderBrush="#BDC3C7"
                                            BorderThickness="1,1,1,0"
                                            CornerRadius="6,6,0,0"
                                            Padding="15,10"
                                            Margin="0,0,4,0">
                                        <ContentPresenter ContentSource="Header"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#3498DB"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#2980B9"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Foreground" Value="#34495E"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#ECF0F1"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Border" Property="Background" Value="#2980B9"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </TabControl.Resources>

                <!-- Residuals vs Predicted -->
                <TabItem Header="Residuals vs Predicted">
                    <ContentPresenter Content="{Binding ResidualsVsPredictedChart}" Margin="15"/>
                </TabItem>

                <!-- Predicted vs Actual -->
                <TabItem Header="Predicted vs Actual">
                    <ContentPresenter Content="{Binding PredictedVsActualChart}" Margin="15"/>
                </TabItem>

                <!-- Residual Histogram -->
                <TabItem Header="Residual Distribution">
                    <ContentPresenter Content="{Binding ResidualHistogramChart}" Margin="15"/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Metrics Footer -->
        <Border Grid.Row="2" Background="#F8F9FA" Padding="20" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0"
                Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mean Residual -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"
                        BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Mean Residual"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding MeanResidual, StringFormat={}{0:F4}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#3498DB"/>
                        <TextBlock Text="(should be close to 0)"
                                   FontSize="10"
                                   Foreground="#95A5A6"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Std Residual -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16"
                        BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Standard Deviation of Residuals"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StdResidual, StringFormat={}{0:F4}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#9B59B6"/>
                        <TextBlock Text="(lower is better)"
                                   FontSize="10"
                                   Foreground="#95A5A6"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
