<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.PostTrainingVisualizationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:D2G.Iris.ML.ConfigUI.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="#34495E" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Post-Training Visualizations"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Analyze model performance and results"
                               FontSize="12"
                               Foreground="#BDC3C7"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>


        <Grid Grid.Row="1" Background="#ECF0F1">

            <Border Background="White"
                    CornerRadius="8"
                    Padding="60"
                    Margin="40"
                    Visibility="{Binding HasTrainingResults, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}"
                    BorderBrush="#BDC3C7"
                    BorderThickness="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,25" Opacity="0.5"/>
                    <TextBlock Text="No Training Results Yet"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#34495E"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Train a model to view performance visualizations"
                               FontSize="16"
                               Foreground="#7F8C8D"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>
                    <Border Background="#3498DB"
                            CornerRadius="6"
                            Padding="20,12">
                        <TextBlock FontSize="14" Foreground="White">
                            <Run Text="Tip: " FontWeight="Bold"/>
                            <Run Text="Click 'Launch Training' to train your model and generate visualizations"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>


            <TabControl Grid.Row="0"
                        SelectedIndex="{Binding SelectedVisualizationIndex}"
                        Visibility="{Binding HasTrainingResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="10"
                        Background="Transparent"
                        BorderThickness="0">

                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border"
                                            Background="White"
                                            BorderBrush="#BDC3C7"
                                            BorderThickness="1,1,1,0"
                                            CornerRadius="6,6,0,0"
                                            Padding="20,12"
                                            Margin="0,0,4,0">
                                        <ContentPresenter ContentSource="Header"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#3498DB"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#2980B9"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Foreground" Value="#34495E"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#ECF0F1"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Border" Property="Background" Value="#2980B9"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </TabControl.Resources>


                <TabItem Header="Confusion Matrix"
                         Visibility="{Binding IsConfusionMatrixAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="White"
                            BorderBrush="#BDC3C7"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,6,6,6">
                        <views:ConfusionMatrixView DataContext="{Binding ConfusionMatrix}"/>
                    </Border>
                </TabItem>


                <TabItem Header="ROC-AUC Curve"
                         Visibility="{Binding IsRocCurveAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="White"
                            BorderBrush="#BDC3C7"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,6,6,6">
                        <views:RocCurveView DataContext="{Binding RocCurve}"/>
                    </Border>
                </TabItem>


                <TabItem Header="Precision-Recall Curve"
                         Visibility="{Binding IsPrecisionRecallCurveAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="White"
                            BorderBrush="#BDC3C7"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,6,6,6">
                        <views:PrecisionRecallCurveView DataContext="{Binding PrecisionRecallCurve}"/>
                    </Border>
                </TabItem>


                <TabItem Header="Residual Plot"
                         Visibility="{Binding IsResidualPlotAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="White"
                            BorderBrush="#BDC3C7"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,6,6,6">
                        <views:ResidualPlotView DataContext="{Binding ResidualPlot}"/>
                    </Border>
                </TabItem>


                <TabItem Header="Feature Importance"
                         Visibility="{Binding IsFeatureImportanceAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="White"
                            BorderBrush="#BDC3C7"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,6,6,6">
                        <views:FeatureImportanceView DataContext="{Binding FeatureImportance}"/>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
