<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.BoxPlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:s="http://schemas.abtsoftware.co.uk/scichart"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Box Plot Analysis" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                   
                    <TextBlock Grid.Column="0" Text="Column:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding NumericColumns}"
                              SelectedItem="{Binding SelectedColumn}"
                              DisplayMemberPath="."
                              Height="30"/>

                   
                    <Button Grid.Column="3"
                            Content="Generate Plot"
                            Command="{Binding GeneratePlotCommand}"
                            Height="30"
                            Padding="20,0"
                            Background="#FF4682B4"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF5A9BD5"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#FFCCCCCC"/>
                                        <Setter Property="Foreground" Value="#FF888888"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        
        <Grid Grid.Row="1" Margin="15">
         
            <s:SciChartSurface x:Name="BoxPlotChart">
                <s:SciChartSurface.XAxis>
                    <s:NumericAxis DrawMajorBands="False"
                                   GrowBy="0.5, 0.5"
                                   AutoRange="Always"
                                   VisibleRange="-1, 1"
                                   AxisTitle=""/>
                </s:SciChartSurface.XAxis>
                <s:SciChartSurface.YAxis>
                    <s:NumericAxis DrawMajorBands="True"
                                   GrowBy="0.1, 0.1"
                                   AutoRange="Always"
                                   AxisTitle="Value"/>
                </s:SciChartSurface.YAxis>
                <s:SciChartSurface.ChartModifier>
                    <s:ModifierGroup>
                        <s:ZoomPanModifier/>
                        <s:MouseWheelZoomModifier/>
                        <s:ZoomExtentsModifier/>
                    </s:ModifierGroup>
                </s:SciChartSurface.ChartModifier>
            </s:SciChartSurface>


            <!-- Loading Overlay with Animated Dots -->
            <Border Background="#80FFFFFF"
                    Visibility="{Binding IsGeneratingPlot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Ellipse x:Name="Dot1" Width="12" Height="12" Fill="#007ACC" Margin="0,0,8,0">
                            <Ellipse.Resources>
                                <Storyboard x:Key="BounceStoryboard1" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                   From="0" To="-20" Duration="0:0:0.6"
                                                   AutoReverse="True" BeginTime="0:0:0"/>
                                </Storyboard>
                            </Ellipse.Resources>
                            <Ellipse.RenderTransform>
                                <TranslateTransform/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource BounceStoryboard1}"/>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse x:Name="Dot2" Width="12" Height="12" Fill="#007ACC" Margin="0,0,8,0">
                            <Ellipse.Resources>
                                <Storyboard x:Key="BounceStoryboard2" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                   From="0" To="-20" Duration="0:0:0.6"
                                                   AutoReverse="True" BeginTime="0:0:0.2"/>
                                </Storyboard>
                            </Ellipse.Resources>
                            <Ellipse.RenderTransform>
                                <TranslateTransform/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource BounceStoryboard2}"/>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse x:Name="Dot3" Width="12" Height="12" Fill="#007ACC">
                            <Ellipse.Resources>
                                <Storyboard x:Key="BounceStoryboard3" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                   From="0" To="-20" Duration="0:0:0.6"
                                                   AutoReverse="True" BeginTime="0:0:0.4"/>
                                </Storyboard>
                            </Ellipse.Resources>
                            <Ellipse.RenderTransform>
                                <TranslateTransform/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource BounceStoryboard3}"/>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </StackPanel>

                    <TextBlock Text="{Binding ProgressMessage}" FontSize="14" FontWeight="Medium"
                               HorizontalAlignment="Center" TextAlignment="Center" Foreground="#333"/>
                </StackPanel>
            </Border>


            <!-- Empty State -->
            <Border Background="#FAFAFA">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding BoxPlotData}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding IsGeneratingPlot}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Select a column and click Generate Plot"
                               FontSize="14"
                               Foreground="#888888"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="20,0"/>
                    <TextBlock Text="Box plots show quartiles, outliers, and statistical distribution of your data"
                               FontSize="11"
                               Foreground="#AAAAAA"
                               HorizontalAlignment="Center"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="20,10,20,0"/>
                </StackPanel>
            </Border>
        </Grid>


        <!-- Footer with Statistics Info -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊 " FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatisticsInfo}" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
