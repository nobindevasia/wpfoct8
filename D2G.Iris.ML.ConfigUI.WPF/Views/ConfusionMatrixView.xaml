<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.ConfusionMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Style for heatmap cell text -->
        <Style x:Key="HeatmapTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ConfusionMatrixCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#424242"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="15,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Confusion Matrix" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>

                <!-- Metrics Summary -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Accuracy Card -->
                    <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="10,8" Margin="0,0,8,0"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Accuracy" FontSize="10" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Accuracy}" FontSize="18" FontWeight="Bold" Foreground="#27AE60" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Precision Card -->
                    <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="10,8" Margin="0,0,8,0"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Precision" FontSize="10" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Precision}" FontSize="18" FontWeight="Bold" Foreground="#3498DB" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Recall Card -->
                    <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="10,8" Margin="0,0,8,0"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Recall" FontSize="10" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Recall}" FontSize="18" FontWeight="Bold" Foreground="#E67E22" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- F1 Score Card -->
                    <Border Grid.Column="3" Background="White" CornerRadius="6" Padding="10,8"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="F1 Score" FontSize="10" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding F1Score}" FontSize="18" FontWeight="Bold" Foreground="#9B59B6" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="15,10,15,15">
            <!-- No Data Message -->
            <Border Background="White" CornerRadius="8" Padding="40"
                    Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="No Confusion Matrix Data Available"
                               FontSize="18" FontWeight="SemiBold" Foreground="#7F8C8D"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Run a classification model training to generate confusion matrix"
                               FontSize="14" Foreground="#95A5A6"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Confusion Matrix Heatmap -->
            <Border Background="White" CornerRadius="8" Padding="15"
                    Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="380"/>
                    </Grid.RowDefinitions>

                    <!-- Chart Title and Legend -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Classification Results" FontSize="13" FontWeight="Bold" Foreground="#34495E"/>
                            <TextBlock Text="Predicted vs Actual Classes" FontSize="10" Foreground="#95A5A6" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Darker = higher values" FontSize="9" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Confusion Matrix Grid -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column headers -->
                        <ItemsControl Grid.Row="0" Grid.Column="2" ItemsSource="{Binding ClassLabels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"
                                                 Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4">
                                        <TextBlock Text="{Binding}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C3E50"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Row headers -->
                        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ClassLabels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1"
                                                 Rows="{Binding DataContext.RowCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="4">
                                        <TextBlock Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C3E50"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Confusion matrix cells -->
                        <ItemsControl Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding DataContext.RowCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ConfusionMatrixCellBorderStyle}"
                                            Background="{Binding BackgroundColor}"
                                            ToolTip="{Binding Tooltip}">
                                        <Grid>
                                            <TextBlock Text="{Binding DisplayValue}"
                                                       Style="{StaticResource HeatmapTextStyle}"
                                                       Foreground="{Binding ForegroundColor}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Y-axis label -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Actual Class"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#546E7A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>

                        <!-- X-axis label -->
                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   Text="Predicted Class"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#546E7A"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
