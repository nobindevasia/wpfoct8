<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.FeatureImportanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:s="http://schemas.abtsoftware.co.uk/scichart"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#F8F9FA" Padding="20" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Feature Importance Analysis"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#2C3E50"/>
                <TextBlock Text="Permutation Feature Importance showing which features contribute most to predictions"
                           FontSize="12"
                           Foreground="#7F8C8D"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Chart Area -->
        <Grid Grid.Row="1" Margin="20">
            <!-- No Data Placeholder -->
            <Border Background="#F8F9FA"
                    CornerRadius="8"
                    Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📊" FontSize="64" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="No Feature Importance Data Available"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#7F8C8D"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                    <TextBlock Text="Feature importance is calculated after model training"
                               FontSize="12"
                               Foreground="#95A5A6"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Chart Display -->
            <ContentPresenter Content="{Binding FeatureImportanceChart}"
                              Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- Metrics Footer -->
        <Border Grid.Row="2" Background="#F8F9FA" Padding="20" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0"
                Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Features -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"
                        BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Total Features"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding FeatureCount}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#3498DB"/>
                    </StackPanel>
                </Border>

                <!-- Top Feature Score -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"
                        BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Top Importance"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TopFeatureScore, StringFormat={}{0:F4}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#27AE60"/>
                    </StackPanel>
                </Border>

                <!-- Most Important Feature -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16"
                        BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Most Important Feature"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TopFeature}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#9B59B6"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding TopFeature}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
