<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
		<PackageReference Include="Microsoft.ML.OnnxConverter" Version="0.22.2" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
		<PackageReference Include="Microsoft.ML.OnnxTransformer" Version="4.0.2" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1901.177" />
		<PackageReference Include="Plotly.NET" Version="4.2.0" />
		<PackageReference Include="SciChart" Version="6.2.0.13254" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\D2G.Iris.ML\D2G.Iris.ML.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Styles\*.xaml" />
	</ItemGroup>

</Project>
