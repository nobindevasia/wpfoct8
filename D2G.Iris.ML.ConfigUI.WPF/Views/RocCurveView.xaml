<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.RocCurveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:s="http://schemas.abtsoftware.co.uk/scichart"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="#F8F9FA" Padding="20" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ROC Curve Analysis"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#2C3E50"/>
                    <TextBlock Text="Receiver Operating Characteristic curve showing classifier performance"
                               FontSize="12"
                               Foreground="#7F8C8D"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#27AE60"
                        CornerRadius="8"
                        Padding="16,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="AUC Score: "
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AucScore, StringFormat={}{0:F4}}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ROC Curve Chart -->
        <Grid Grid.Row="1" Margin="20">
            <!-- Empty State -->
            <Border Background="#F8F9FA"
                    CornerRadius="8"
                    Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📊" FontSize="64" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="No ROC Curve Data Available"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#7F8C8D"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- SciChart Surface -->
            <ContentPresenter Content="{Binding RocCurveChart}"
                              Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- Statistics Panel -->
        <Border Grid.Row="2" Background="#F8F9FA" Padding="20" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0"
                Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- AUC Score -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"
                        BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="AUC Score"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding AucScore, StringFormat={}{0:F4}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#27AE60"/>
                    </StackPanel>
                </Border>

                <!-- Optimal Threshold -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"
                        BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Optimal Threshold"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding OptimalThreshold, StringFormat={}{0:F4}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#3498DB"/>
                    </StackPanel>
                </Border>

                <!-- True Positive Rate at Optimal -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="0,0,10,0"
                        BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TPR at Optimal"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TprAtOptimal, StringFormat={}{0:P2}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#9B59B6"/>
                    </StackPanel>
                </Border>

                <!-- False Positive Rate at Optimal -->
                <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="16"
                        BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="FPR at Optimal"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding FprAtOptimal, StringFormat={}{0:P2}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#E74C3C"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
