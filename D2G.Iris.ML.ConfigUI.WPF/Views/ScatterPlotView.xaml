<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.ScatterPlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:s="http://schemas.abtsoftware.co.uk/scichart"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Scatter Plot Analysis" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0" Text="X Axis:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding NumericColumns}"
                              SelectedItem="{Binding SelectedXColumn}"
                              DisplayMemberPath="."
                              Height="30"/>


                    <TextBlock Grid.Column="3" Text="Y Axis:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding NumericColumns}"
                              SelectedItem="{Binding SelectedYColumn}"
                              DisplayMemberPath="."
                              Height="30"/>


                    <Button Grid.Column="6"
                            Content="Generate Plot"
                            Command="{Binding GeneratePlotCommand}"
                            Height="30"
                            Padding="20,0"
                            Background="#FF4682B4"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF5A9BD5"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#FFCCCCCC"/>
                                        <Setter Property="Foreground" Value="#FF888888"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>


        <Grid Grid.Row="1" Margin="15">

            <s:SciChartSurface x:Name="ScatterChart">
                <s:SciChartSurface.XAxis>
                    <s:NumericAxis DrawMajorBands="True"
                                   GrowBy="0.05, 0.05"
                                   AutoRange="Always"
                                   AxisTitle="{Binding SelectedXColumn}"/>
                </s:SciChartSurface.XAxis>
                <s:SciChartSurface.YAxis>
                    <s:NumericAxis DrawMajorBands="True"
                                   GrowBy="0.05, 0.05"
                                   AutoRange="Always"
                                   AxisTitle="{Binding SelectedYColumn}"/>
                </s:SciChartSurface.YAxis>
                <s:SciChartSurface.RenderableSeries>
                    <s:XyScatterRenderableSeries DataSeries="{Binding ScatterPlotData}"
                                                 Stroke="#FF4682B4"
                                                 StrokeThickness="2">
                        <s:XyScatterRenderableSeries.PointMarker>
                            <s:EllipsePointMarker Width="6" Height="6" Fill="#FF4682B4" Stroke="#FF4682B4"/>
                        </s:XyScatterRenderableSeries.PointMarker>
                    </s:XyScatterRenderableSeries>
                </s:SciChartSurface.RenderableSeries>
                <s:SciChartSurface.ChartModifier>
                    <s:ModifierGroup>
                        <s:RubberBandXyZoomModifier/>
                        <s:ZoomPanModifier/>
                        <s:MouseWheelZoomModifier/>
                        <s:ZoomExtentsModifier/>
                        <s:TooltipModifier/>
                    </s:ModifierGroup>
                </s:SciChartSurface.ChartModifier>
            </s:SciChartSurface>


            <Border Background="#80FFFFFF"
                    Visibility="{Binding IsGeneratingPlot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding ProgressMessage}" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>


            <Border Background="#FAFAFA"
                    Visibility="{Binding ScatterPlotData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ScatterPlotData}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Select X and Y columns, then click Generate Plot"
                               FontSize="14"
                               Foreground="#888888"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>


        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CorrelationInfo}" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
