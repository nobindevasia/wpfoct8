<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.AutoMLSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">

    <GroupBox Header="AutoML Settings" Margin="10">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            
            <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Enable AutoML"
                      IsChecked="{Binding IsEnabled}"
                      FontWeight="Bold"
                      VerticalAlignment="Center"/>

            
            <Label Grid.Row="2" Grid.Column="0" Content="Max Experiment Time:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsEnabled}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding MaxExperimentTimeInSeconds, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" Height="25" Width="80"
                         IsEnabled="{Binding IsEnabled}"/>
                <Label Content="seconds" VerticalAlignment="Center" Margin="5,0,0,0"
                       IsEnabled="{Binding IsEnabled}"/>
            </StackPanel>


            <Label Grid.Row="4" Grid.Column="0" Content="Max Models to Try:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsEnabled}"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding MaxModelsToTry, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Height="25" Width="80"
                         IsEnabled="{Binding IsEnabled}"/>
                <Label Content="models" VerticalAlignment="Center" Margin="5,0,0,0"
                       IsEnabled="{Binding IsEnabled}"/>
            </StackPanel>


            <Label Grid.Row="6" Grid.Column="0" Content="Optimizing Metric:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsEnabled}"/>
            <ComboBox Grid.Row="6" Grid.Column="1"
                      ItemsSource="{Binding AvailableMetrics}"
                      SelectedItem="{Binding OptimizingMetric}"
                      VerticalAlignment="Center" Height="25" Width="200" HorizontalAlignment="Left"
                      IsEnabled="{Binding IsEnabled}"/>


            <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Use Cross Validation"
                      IsChecked="{Binding UseCrossValidation}"
                      VerticalAlignment="Center"
                      IsEnabled="{Binding IsEnabled}"/>


            <Label Grid.Row="10" Grid.Column="0" Content="Number of Folds:" VerticalAlignment="Center"
                   IsEnabled="{Binding UseCrossValidation}"/>
            <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding NumberOfFolds, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Height="25" Width="80"
                         IsEnabled="{Binding UseCrossValidation}"/>
                <Label Content="folds (2-10)" VerticalAlignment="Center" Margin="5,0,0,0"
                       IsEnabled="{Binding UseCrossValidation}"/>
            </StackPanel>

            <!-- Seed Setting -->
            <Label Grid.Row="12" Grid.Column="0" Content="Random Seed:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsEnabled}"/>
            <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Height="25" Width="120"
                         IsEnabled="{Binding IsEnabled}"/>
                <Label Content="(optional, for reproducibility)" VerticalAlignment="Center" Margin="5,0,0,0"
                       IsEnabled="{Binding IsEnabled}" Foreground="Gray" FontSize="11"/>
            </StackPanel>

            <!-- Description -->
            <TextBlock Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="{Binding Description}"
                       TextWrapping="Wrap"
                       Foreground="DarkBlue"
                       Margin="0,10,0,0"/>
        </Grid>
    </GroupBox>
</UserControl>