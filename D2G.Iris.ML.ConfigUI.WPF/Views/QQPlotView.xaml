<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.QQPlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:s="http://schemas.abtsoftware.co.uk/scichart"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Q-Q Plot (Quantile-Quantile Plot)" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Column:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding NumericColumns}"
                              SelectedItem="{Binding SelectedColumn}"
                              DisplayMemberPath="."
                              Height="30"/>

                    <Button Grid.Column="3"
                            Content="Generate Q-Q Plot"
                            Command="{Binding GeneratePlotCommand}"
                            Height="30"
                            Padding="20,0"
                            Background="#FF4682B4"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF5A9BD5"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#FFCCCCCC"/>
                                        <Setter Property="Foreground" Value="#FF888888"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <s:SciChartSurface>
                <s:SciChartSurface.XAxis>
                    <s:NumericAxis AxisTitle="Theoretical Quantiles (Normal Distribution)"/>
                </s:SciChartSurface.XAxis>
                <s:SciChartSurface.YAxis>
                    <s:NumericAxis AxisTitle="Sample Quantiles"/>
                </s:SciChartSurface.YAxis>

                <s:SciChartSurface.RenderableSeries>
                    <s:XyScatterRenderableSeries DataSeries="{Binding QQPlotData}"
                                                 StrokeThickness="0">
                        <s:XyScatterRenderableSeries.PointMarker>
                            <s:EllipsePointMarker Width="4" Height="4" Fill="#FF4682B4" Stroke="#FF4682B4"/>
                        </s:XyScatterRenderableSeries.PointMarker>
                    </s:XyScatterRenderableSeries>

                    <s:FastLineRenderableSeries DataSeries="{Binding ReferenceLine}"
                                               Stroke="Red"
                                               StrokeThickness="2"
                                               StrokeDashArray="5,5"/>
                </s:SciChartSurface.RenderableSeries>

                <s:SciChartSurface.ChartModifier>
                    <s:ModifierGroup>
                        <s:RubberBandXyZoomModifier />
                        <s:ZoomPanModifier />
                        <s:MouseWheelZoomModifier />
                        <s:ZoomExtentsModifier />
                        <s:CursorModifier ShowTooltip="True" />
                    </s:ModifierGroup>
                </s:SciChartSurface.ChartModifier>
            </s:SciChartSurface>

            <Border Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="20"
                    Visibility="{Binding NormalityInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Normality Assessment:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding NormalityInfo}" TextWrapping="Wrap" MaxWidth="300"/>
                    <TextBlock Text="Points close to the red line indicate normal distribution."
                               FontSize="11"
                               Foreground="Gray"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               MaxWidth="300"/>
                </StackPanel>
            </Border>

            <Grid Visibility="{Binding IsGeneratingPlot, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Background="#80000000">
                <Border Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Generating Q-Q Plot..." FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Height="20" Margin="0,15,0,0" Width="200"/>
                        <TextBlock Text="{Binding ProgressMessage}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   MaxWidth="250"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10">
            <TextBlock Text="{Binding ProgressMessage}" Foreground="#666666"/>
        </Border>
    </Grid>
</UserControl>
