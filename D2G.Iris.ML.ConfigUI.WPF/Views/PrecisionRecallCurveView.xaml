<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.PrecisionRecallCurveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:D2G.Iris.ML.ConfigUI.WPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#FAFAFA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Precision-Recall Curve"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"/>
                    <TextBlock Text="Especially useful for imbalanced datasets"
                               FontSize="11"
                               Foreground="#7F8C8D"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <!-- Chart and Statistics -->
            <Grid Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Chart Area -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="6" Padding="15" Margin="0,0,10,0">
                    <ContentPresenter Content="{Binding PrecisionRecallChart}"/>
                </Border>

                <!-- Statistics Panel -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="6" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Curve Metrics"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <!-- Average Precision -->
                        <Border Background="#E8F5E9" BorderBrush="#27AE60" BorderThickness="0,0,0,3"
                                Padding="15,12" Margin="0,0,0,12" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Average Precision (AP)"
                                           FontSize="11"
                                           Foreground="#27AE60"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AveragePrecision, StringFormat={}{0:F4}}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#27AE60"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="Area under PR curve"
                                           FontSize="10"
                                           Foreground="#7F8C8D"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,10,0,15" Background="#E0E0E0"/>

                        <TextBlock Text="Optimal Threshold"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,12"/>

                        <!-- Threshold Value -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Threshold" FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock Grid.Column="1" Text="{Binding OptimalThreshold, StringFormat={}{0:F4}}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#34495E"/>
                        </Grid>

                        <!-- Precision at Optimal -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Precision" FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock Grid.Column="1" Text="{Binding PrecisionAtOptimal, StringFormat={}{0:F4}}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#34495E"/>
                        </Grid>

                        <!-- Recall at Optimal -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Recall" FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock Grid.Column="1" Text="{Binding RecallAtOptimal, StringFormat={}{0:F4}}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#34495E"/>
                        </Grid>

                        <!-- F1 Score at Optimal -->
                        <Border Background="#E3F2FD" BorderBrush="#3498DB" BorderThickness="1"
                                Padding="12,8" Margin="0,5,0,0" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="F1 Score"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#3498DB"/>
                                <TextBlock Grid.Column="1" Text="{Binding F1AtOptimal, StringFormat={}{0:F4}}"
                                           FontSize="13" FontWeight="Bold" Foreground="#3498DB"/>
                            </Grid>
                        </Border>

                        <Separator Margin="0,20,0,15" Background="#E0E0E0"/>

                        <!-- Information Box -->
                        <Border Background="#FFF8E1" BorderBrush="#FFC107" BorderThickness="1"
                                Padding="12" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="About PR Curves"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#856404"
                                           Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="10"
                                           Foreground="#856404"
                                           LineHeight="16">
                                    <Run Text="PR curves are more informative than ROC curves when dealing with imbalanced datasets. Higher AP values indicate better model performance."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Empty State -->
            <Border Background="White" CornerRadius="16" Padding="40,30"
                    Visibility="{Binding HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    BorderBrush="#E0E0E0" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Ellipse Width="14" Height="14" Fill="#2ECC71" Margin="0,0,8,0"/>
                        <Ellipse Width="14" Height="14" Fill="#3498DB" Margin="0,0,8,0"/>
                        <Ellipse Width="14" Height="14" Fill="#E74C3C"/>
                    </StackPanel>

                    <TextBlock Text="No Precision-Recall Data Available"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#7F8C8D"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Train a binary classification model to see the Precision-Recall curve"
                               FontSize="13"
                               Foreground="#95A5A6"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="400"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
