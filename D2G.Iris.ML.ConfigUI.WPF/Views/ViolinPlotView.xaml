<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.ViolinPlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:converters="clr-namespace:D2G.Iris.ML.ConfigUI.WPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header and Controls -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Violin Plot Analysis" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column Selection -->
                    <TextBlock Grid.Column="0" Text="Select Column:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding NumericColumns}"
                              SelectedItem="{Binding SelectedColumn}"
                              DisplayMemberPath="."
                              Height="30"/>

                    <!-- Generate Button -->
                    <Button Grid.Column="3"
                            Content="Generate Violin Plot"
                            Command="{Binding GeneratePlotCommand}"
                            Height="30"
                            Padding="20,0"
                            Background="#FF4682B4"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF5A9BD5"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#FFCCCCCC"/>
                                        <Setter Property="Foreground" Value="#FF888888"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Chart Area -->
        <Grid Grid.Row="1" Margin="15">
            <!-- Violin Plot rendered with WebView2 -->
            <wv2:WebView2 x:Name="PlotWebView"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          DefaultBackgroundColor="White"
                          Visibility="{Binding IsGeneratingPlot, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <!-- Loading Overlay - Shows when generating plot -->
            <Grid Visibility="{Binding IsGeneratingPlot, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Background="#F5F5F5">
                <Border Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Generating Violin Plot..." FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Height="20" Margin="0,15,0,0" Width="200"/>
                        <TextBlock Text="{Binding ProgressMessage}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   MaxWidth="250"
                                   TextAlignment="Center"
                                   Foreground="#333"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Empty State - Temporarily commented out for debugging -->
            <!--<Border Background="#FAFAFA">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlotHtml}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding IsGeneratingPlot}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="#FF6B6B"
                               HorizontalAlignment="Center" Margin="0,0,0,15"
                               Text="⚠ No Data Available"/>
                    <TextBlock Text="Please click 'Analyze Data' on the Data Summary tab first"
                               FontSize="14"
                               Foreground="#888888"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="20,0,20,10"/>
                    <TextBlock Text="Then select a numeric column and click Generate Violin Plot"
                               FontSize="13"
                               Foreground="#999999"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="20,0"/>
                    <TextBlock Text="Violin plots show the distribution shape and statistical summary of your data"
                               FontSize="11"
                               Foreground="#AAAAAA"
                               HorizontalAlignment="Center"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="20,15,20,0"/>
                </StackPanel>
            </Border>-->
        </Grid>

        <!-- Footer with Statistics Info -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Statistics: " FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding StatisticsInfo}" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
